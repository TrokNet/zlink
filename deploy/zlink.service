[Unit]
Description=ZLINK FastAPI
After=network.target

[Service]
Type=simple
User=trok
Group=trok
WorkingDirectory=/home/trok/apps/zlink
ExecStart=/home/trok/apps/zlink/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 3000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=027

[Install]
WantedBy=multi-user.target
